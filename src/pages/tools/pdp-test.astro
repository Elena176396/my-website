---
import PDPTest from '../../components/PDPTest.jsx';

const canonical = 'https://songchaoyang.com/tools/pdp-test/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" />
    <title>PDP-行为风格测试</title>
    <meta name="description" content="完成 30 道题，了解你在老虎、孔雀、考拉、猫头鹰和变色龙五种 PDP 行为风格中的组合。" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content="PDP-行为风格测试" />
    <meta property="og:description" content="30 道题，发现你的五种行为风格组合。" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; min-height: 100%; background: #0f172a; }
      .site-back { position: fixed; top: 14px; left: 16px; z-index: 20; color: rgba(255,255,255,.55); text-decoration: none; font: 600 12px/1.4 -apple-system, "PingFang SC", sans-serif; }
      .site-back:hover { color: #fff; }
    </style>
  </head>
  <body>
    <a class="site-back" href="/tools/#decode">← 返回人格解码</a>
    <PDPTest client:load />
  </body>
</html>
