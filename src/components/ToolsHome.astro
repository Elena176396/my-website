---
const categories = [
  { id: 'decode', label: '人格解码', color: '#6e7488', soft: 'rgba(110,116,136,.1)', light: '#8b92aa' },
  { id: 'mystic', label: '玄学引擎', color: '#706888', soft: 'rgba(112,104,136,.1)', light: '#8d84a6' },
  { id: 'boost',  label: '效率外挂', color: '#5e7080', soft: 'rgba(94,112,128,.1)',  light: '#7a919f' },
  { id: 'spark',  label: '灵感弹珠', color: '#6e7488', soft: 'rgba(110,116,136,.1)', light: '#8b92aa' },
];

const catMap = Object.fromEntries(categories.map(c => [c.id, c]));

/* ── Spotlight: change this to feature any tool ── */
const spotlight = {
  cat: 'spark',
  href: '/tools/parent-child-mirror/',
  label: '✦ 最近上新',
  title: '亲子照镜子',
  desc: '从真实亲子场景里的第一反应，看见自己的沟通模式。没有对错，只有觉察和新的选择。',
  icon: '亲',
  btnText: '立刻试试',
};

const bentoBlocks = [
  { cat: 'boost',  label: '效率外挂', desc: '专注计时 · 考研词汇 · MBA 口语 · 回译与语感', deco: '时词研\n商译感', bg: 'rgba(140,160,175,.32)', c: '#48606e', count: 9 },
  { cat: 'decode', label: '人格解码', desc: 'MBTI · 九型人格 · 人格融合测试',              deco: 'M九融',         bg: 'rgba(155,150,175,.32)', c: '#555068', count: 3 },
  { cat: 'mystic', label: '玄学引擎', desc: '八字排盘 · 五行关系 · 生肖图谱',              deco: '八五肖',        bg: 'rgba(148,140,170,.32)', c: '#564e6e', count: 3 },
  { cat: 'spark',  label: '灵感弹珠', desc: '亲子觉察 · 认知学习 · 世界观闯关',              deco: '亲脑认\n世言书',    bg: 'rgba(148,155,172,.32)', c: '#4e5568', count: 6 },
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#e7e9ed" />
  <title>Song Chaoyang · 工具与模拟器</title>
  <meta name="description" content="宋超洋的互动工具实验场——人格解码、玄学引擎、效率外挂与灵感弹珠。把好奇心做成工具。" />
  <link rel="canonical" href="https://songchaoyang.com/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

  <header>
    <div class="wrap header-inner">
      <a class="brand" href="/">SONG CHAOYANG</a>
      <a class="gh-link" href="https://github.com/Elena176396" rel="noopener noreferrer" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
      </a>
    </div>
  </header>

  <main>

    <!-- ② HERO with keyword tag line -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-tag">不会写代码 · 好奇心驱动 · AI 辅助造工具</div>
        <h1>把好奇心做成工具</h1>
        <p class="subtitle">This is a playground — you're invited to come and play.</p>
        <a class="cta" href="#categories">
          开始探索
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- ① SPOTLIGHT -->
    <section class="spotlight-section">
      <div class="wrap">
        <div class="spotlight">
          <div class="spotlight-text">
            <div class="spotlight-label" style={`color:${catMap[spotlight.cat].light}`}>{spotlight.label}</div>
            <h2>{spotlight.title}</h2>
            <p class="spotlight-desc">{spotlight.desc}</p>
            <div class="spotlight-actions">
              <a class="btn-primary" href={spotlight.href}>
                {spotlight.btnText}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
              <a class="btn-ghost" href="/tools/">查看全部工具</a>
            </div>
          </div>
          <div class="spotlight-visual">
            <div class="spot-deco" style={`--sc:${catMap[spotlight.cat].color}`}>
              <span class="spot-glyph">{spotlight.icon}</span>
              <span class="spot-label">{catMap[spotlight.cat].label}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION HEADING -->
    <section class="section-heading">
      <div class="wrap">
        <div class="section-rule" aria-hidden="true"></div>
        <h2>15 个实验，4 个方向</h2>
        <p class="section-sub">Every tool here started as a "what if" — pick a direction and start playing.</p>
      </div>
    </section>

    <!-- BENTO -->
    <section class="categories" id="categories">
      <div class="wrap">
        <div class="bento-row">
          {bentoBlocks.slice(0, 2).map(b => (
            <a class="bento" href={`/tools/#${b.cat}`} style={`--bg:${b.bg};--c:${b.c}`}>
              <div class="bento-deco" set:html={b.deco.replace('\n', '<br/>')} />
              <h3>{b.label}</h3>
              <p>{b.desc}</p>
              <span class="bento-count">{b.count} 个工具 →</span>
            </a>
          ))}
        </div>
        <div class="bento-row">
          {bentoBlocks.slice(2, 4).map(b => (
            <a class="bento" href={`/tools/#${b.cat}`} style={`--bg:${b.bg};--c:${b.c}`}>
              <div class="bento-deco" set:html={b.deco.replace('\n', '<br/>')} />
              <h3>{b.label}</h3>
              <p>{b.desc}</p>
              <span class="bento-count">{b.count} 个工具 →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>© 2026 Song Chaoyang</span>
      <a href="https://github.com/Elena176396" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </footer>

</body>
</html>


<style>
  :global(*) { box-sizing: border-box; margin: 0; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    color: #1a1c1e; background: #e7e9ed;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    position: relative; min-height: 100vh; overflow-x: hidden;
  }
  :global(body)::before {
    content: ''; position: fixed; top: 0; left: 0; width: 140%; height: 140%;
    background:
      radial-gradient(circle 550px at 10% 15%, rgba(80,100,180,.18), transparent),
      radial-gradient(circle 450px at 85% 10%, rgba(120,90,170,.14), transparent),
      radial-gradient(circle 600px at 55% 60%, rgba(70,140,160,.12), transparent),
      radial-gradient(circle 400px at 30% 80%, rgba(90,110,170,.1), transparent);
    z-index: 0; pointer-events: none;
    animation: drift 28s ease-in-out infinite alternate;
  }
  @keyframes drift {
    0%  { transform: translate(0,0) scale(1); }
    33% { transform: translate(-4%,2%) scale(1.02); }
    66% { transform: translate(3%,-3%) scale(.98); }
    100%{ transform: translate(-2%,4%) scale(1.01); }
  }
  :global(body) > * { position: relative; z-index: 1; }
  .wrap { width: min(1100px, calc(100% - 48px)); margin-inline: auto; }

  /* ═══ HEADER ═══ */
  header {
    position: sticky; top: 0; z-index: 10;
    background: rgba(231,233,237,.48);
    backdrop-filter: blur(24px) saturate(1.3); -webkit-backdrop-filter: blur(24px) saturate(1.3);
    border-bottom: 1px solid rgba(255,255,255,.4);
    background-image: linear-gradient(135deg, rgba(255,255,255,.15) 0%, transparent 40%);
  }
  .header-inner { height: 64px; display: flex; align-items: center; justify-content: space-between; }
  .brand { color: inherit; text-decoration: none; font-size: 12.5px; font-weight: 780; letter-spacing: .14em; }
  .gh-link {
    display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; color: #8a8d96;
    background: rgba(255,255,255,.25); border: 1px solid rgba(255,255,255,.45);
    border-radius: 50%; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: color .2s, background .2s;
  }
  .gh-link:hover { color: #1a1c1e; background: rgba(255,255,255,.45); }

  /* ═══ HERO ═══ */
  .hero { padding: clamp(72px,12vw,140px) 0 clamp(48px,7vw,80px); text-align: center; }
  .hero-tag {
    font-size: 12px; letter-spacing: .06em; color: #8b92aa;
    margin-bottom: 20px;
  }
  h1 { font-size: clamp(36px,7vw,64px); font-weight: 820; line-height: 1.15; letter-spacing: -.04em; color: #0a0a0c; }
  .subtitle { max-width: 460px; margin: 18px auto 0; font-size: clamp(13px,1.6vw,15px); line-height: 1.7; color: #8e919a; }
  .cta {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 28px; padding: 13px 28px;
    font-size: 14px; font-weight: 680; color: #1a1c1e;
    background: rgba(255,255,255,.28);
    background-image: linear-gradient(135deg, rgba(255,255,255,.22) 0%, transparent 50%);
    backdrop-filter: blur(12px) saturate(1.2); -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgba(255,255,255,.55); border-radius: 999px; text-decoration: none;
    box-shadow: 0 2px 10px rgba(50,55,80,.08), inset 0 1px 0 rgba(255,255,255,.5);
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .cta:hover {
    transform: translateY(-2px); background: rgba(30,34,50,.82); background-image: none;
    color: #fff; border-color: rgba(255,255,255,.15); box-shadow: 0 6px 24px rgba(40,50,80,.2);
  }
  .cta svg { transition: transform .2s; }
  .cta:hover svg { transform: translateX(3px); }
  /* ═══ SPOTLIGHT ═══ */
  .spotlight-section { padding: 0 0 clamp(36px,5vw,56px); }
  .spotlight {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0;
    border-radius: 16px; overflow: hidden;
    background: rgba(255,255,255,.22);
    background-image: linear-gradient(135deg, rgba(255,255,255,.18) 0%, transparent 40%);
    backdrop-filter: blur(20px) saturate(1.2); -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border: 1px solid rgba(255,255,255,.4);
    box-shadow: 0 2px 10px rgba(50,55,80,.04), inset 0 1px 0 rgba(255,255,255,.4);
  }
  .spotlight-text { padding: 40px 44px; display: flex; flex-direction: column; justify-content: center; }
  .spotlight-label { font-size: 11px; letter-spacing: .08em; margin-bottom: 14px; font-weight: 600; }
  .spotlight h2 { font-size: 26px; font-weight: 720; letter-spacing: -.02em; margin-bottom: 12px; color: #0a0a0c; }
  .spotlight-desc { font-size: 14px; color: #6a6d76; line-height: 1.7; margin-bottom: 28px; }
  .spotlight-actions { display: flex; align-items: center; gap: 18px; }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 28px; border-radius: 999px; text-decoration: none;
    font-size: 14px; font-weight: 680; color: #1a1c1e;
    background: rgba(255,255,255,.28);
    background-image: linear-gradient(135deg, rgba(255,255,255,.22) 0%, transparent 50%);
    backdrop-filter: blur(12px) saturate(1.2); -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgba(255,255,255,.55);
    box-shadow: 0 2px 10px rgba(50,55,80,.08), inset 0 1px 0 rgba(255,255,255,.5);
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .btn-primary:hover {
    transform: translateY(-2px); background: rgba(30,34,50,.82); background-image: none;
    color: #fff; border-color: rgba(255,255,255,.15); box-shadow: 0 6px 24px rgba(40,50,80,.2);
  }
  .btn-primary svg { transition: transform .2s; }
  .btn-primary:hover svg { transform: translateX(3px); }
  .btn-ghost {
    display: inline-flex; align-items: center; padding: 6px 0;
    font-size: 13px; font-weight: 500; text-decoration: none; color: #8a8d96;
    border-bottom: 1px solid transparent; transition: border-color .2s, color .2s;
  }
  .btn-ghost:hover { border-color: currentColor; color: #1a1c1e; }

  .spotlight-visual {
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,.06);
    border-left: 1px solid rgba(255,255,255,.3);
    min-height: 260px; position: relative; overflow: hidden;
  }
  .spot-deco {
    width: 130px; height: 180px; border-radius: 14px;
    border: 1px solid rgba(255,255,255,.35);
    background: linear-gradient(145deg, color-mix(in srgb, var(--sc) 15%, rgba(255,255,255,.2)), rgba(255,255,255,.08));
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    transform: rotate(-3deg);
    transition: transform .4s ease;
    box-shadow: 0 8px 32px rgba(50,55,80,.08);
  }
  .spotlight:hover .spot-deco { transform: rotate(0deg) scale(1.03); }
  .spot-glyph {
    font-family: Georgia, "Songti SC", serif;
    font-size: 42px; line-height: 1; color: var(--sc); opacity: .6;
  }
  .spot-label { font-size: 11px; letter-spacing: .06em; color: #8a8d96; }

  /* ═══ SECTION HEADING ═══ */
  .section-heading { text-align: center; padding: clamp(24px,4vw,48px) 0 clamp(32px,5vw,56px); }
  .section-rule { width: 40px; height: 2px; margin: 0 auto 24px; background: rgba(50,55,80,.15); border-radius: 2px; }
  .section-heading h2 { font-size: clamp(28px,5vw,44px); font-weight: 800; letter-spacing: -.04em; line-height: 1.15; color: #0a0a0c; }
  .section-sub { max-width: 480px; margin: 16px auto 0; font-size: clamp(13px,1.5vw,14.5px); line-height: 1.7; color: #8e919a; }

  /* ═══ BENTO ═══ */
  .categories { padding-bottom: clamp(60px,8vw,100px); }
  .bento-row { display: grid; gap: 14px; margin-bottom: 14px; }
  .bento-row:nth-child(1) { grid-template-columns: 3fr 2fr; }
  .bento-row:nth-child(2) { grid-template-columns: 2fr 3fr; }
  .bento {
    position: relative; overflow: hidden; min-height: clamp(200px,22vw,260px);
    border-radius: 22px; padding: 32px 36px;
    display: flex; flex-direction: column; justify-content: flex-end;
    background: var(--bg);
    background-image: linear-gradient(135deg, rgba(255,255,255,.2) 0%, transparent 45%);
    backdrop-filter: blur(20px) saturate(1.2); -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border: 1px solid rgba(255,255,255,.42);
    box-shadow: 0 2px 8px rgba(50,55,80,.03), inset 0 1px 0 rgba(255,255,255,.4);
    text-decoration: none; color: #1a1c1e;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease, filter .3s ease;
  }
  .bento:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.65); box-shadow: 0 10px 36px rgba(50,55,80,.09), inset 0 1px 0 rgba(255,255,255,.55); filter: brightness(1.06); }
  .bento h3 { font-size: clamp(22px,2.8vw,28px); font-weight: 760; letter-spacing: -.03em; margin-bottom: 8px; }
  .bento p { font-size: 14px; color: rgba(26,28,30,.36); line-height: 1.6; max-width: 280px; }
  .bento-count { display: inline-flex; align-items: center; gap: 4px; margin-top: 14px; font-size: 12.5px; font-weight: 650; color: var(--c); opacity: .55; }
  .bento-deco {
    position: absolute; top: 50%; right: 24px; transform: translateY(-50%);
    font-family: Georgia, "Songti SC", "STSong", serif;
    font-size: clamp(72px,10vw,100px); line-height: .95; letter-spacing: -.06em;
    color: var(--c); opacity: .06; pointer-events: none; white-space: nowrap;
  }

  /* ═══ FOOTER ═══ */
  footer { border-top: 1px solid rgba(255,255,255,.3); }
  .footer-inner { padding: 28px 0 48px; display: flex; justify-content: space-between; color: #9a9da6; font-size: 13px; }
  .footer-inner a { color: inherit; text-decoration: none; transition: color .15s; }
  .footer-inner a:hover { color: #555860; }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 860px) {
    .spotlight { grid-template-columns: 1fr; }
    .spotlight-visual { border-left: none; border-top: 1px solid rgba(255,255,255,.3); min-height: 180px; }
    .spotlight-text { padding: 32px 28px; }
    .bento-deco { font-size: 64px; right: 16px; }
  }
  @media (max-width: 560px) {
    .wrap { width: min(100% - 32px, 1100px); }
    .hero { padding: 48px 0 44px; }
    .cta { margin-top: 24px; padding: 11px 24px; font-size: 13px; }
    .spotlight-actions { align-items: flex-start; flex-direction: column; gap: 10px; }
    .btn-primary { padding: 11px 24px; font-size: 13px; }
    .section-heading { padding: 20px 0 28px; }
    .section-rule { margin-bottom: 16px; }
    .bento-row:nth-child(1), .bento-row:nth-child(2) { grid-template-columns: 1fr; }
    .bento { min-height: 180px; padding: 24px 28px; border-radius: 18px; }
    .bento h3 { font-size: 22px; }
    .bento-deco { font-size: 56px; right: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    :global(body)::before { animation: none !important; }
    *, *::before, *::after { transition-duration: 0s !important; }
  }
</style>
