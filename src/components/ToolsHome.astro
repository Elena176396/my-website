---
const categories = [
  { id: 'decode', label: '人格解码', color: '#6e7488', soft: 'rgba(110,116,136,.1)' },
  { id: 'mystic', label: '玄学引擎', color: '#706888', soft: 'rgba(112,104,136,.1)' },
  { id: 'boost',  label: '效率外挂', color: '#5e7080', soft: 'rgba(94,112,128,.1)' },
  { id: 'spark',  label: '灵感弹珠', color: '#6e7488', soft: 'rgba(110,116,136,.1)' },
];

const tools = [
  { cat: 'decode', href: '/tools/mbti-simulator/',            icon: 'M',  short: 'MBTI' },
  { cat: 'decode', href: '/tools/enneagram-pro/',              icon: '九', short: '九型人格' },
  { cat: 'decode', href: '/tools/mbti-enneagram-fusion/',      icon: '融', short: 'MBTI×九型' },
  { cat: 'mystic', href: '/tools/bazi-calculator/',            icon: '八', short: '八字排盘' },
  { cat: 'mystic', href: '/tools/wuxing-explainer/',           icon: '五', short: '五行关系' },
  { cat: 'mystic', href: '/tools/zodiac-compatibility-chart/', icon: '肖', short: '生肖关系' },
  { cat: 'boost',  href: '/tools/focus-timer/',                icon: '时', short: '专注计时' },
  { cat: 'spark',  href: '/tools/quote-wheel/',                icon: '言', short: '名言转盘' },
  { cat: 'spark',  href: '/tools/have-fun/',                   icon: '书', short: '拾光读书' },
  { cat: 'boost',  href: '/tools/vocab-1341/',                 icon: '词', short: '词汇1341' },
  { cat: 'boost',  href: '/tools/vocab-3728/',                 icon: '研', short: '词汇3728' },
  { cat: 'boost',  href: '/tools/vocab-4533/',                 icon: '英', short: '词汇4533' },
  { cat: 'boost',  href: '/tools/mba-vocab-632/',              icon: '商', short: 'MBA词汇' },
  { cat: 'boost',  href: '/tools/mba-english-dialogue-practice/', icon: '说', short: 'MBA对话' },
  { cat: 'boost',  href: '/tools/mba-interview-listening/',    icon: '听', short: 'MBA听力' },
];

const catMap = Object.fromEntries(categories.map(c => [c.id, c]));

const bentoBlocks = [
  { cat: 'boost',  label: '效率外挂', desc: '专注计时 · 考研词汇 · MBA 口语 · 面试听力', deco: '时词研\n商说听', bg: 'rgba(140,160,175,.32)', c: '#48606e', count: 7 },
  { cat: 'decode', label: '人格解码', desc: 'MBTI · 九型人格 · 人格融合测试',              deco: 'M九融',         bg: 'rgba(155,150,175,.32)', c: '#555068', count: 3 },
  { cat: 'mystic', label: '玄学引擎', desc: '八字排盘 · 五行关系 · 生肖图谱',              deco: '八五肖',        bg: 'rgba(148,140,170,.32)', c: '#564e6e', count: 3 },
  { cat: 'spark',  label: '灵感弹珠', desc: '名言转盘 · 拾光读书会',                        deco: '言书',          bg: 'rgba(148,155,172,.32)', c: '#4e5568', count: 2 },
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#e7e9ed" />
  <title>Song Chaoyang · 工具与模拟器</title>
  <meta name="description" content="宋超洋的互动工具实验场——人格解码、玄学引擎、效率外挂与灵感弹珠。把好奇心做成工具。" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>

  <header>
    <div class="wrap header-inner">
      <a class="brand" href="/">SONG CHAOYANG</a>
      <a class="gh-link" href="https://github.com/Elena176396" rel="noopener noreferrer" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
      </a>
    </div>
  </header>

  <main>

    <section class="hero">
      <div class="wrap">
        <h1>把好奇心做成工具</h1>
        <p class="subtitle">This is a playground — you're invited to come and play.</p>
        <a class="cta" href="#categories">开始探索 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      </div>
    </section>

    <section class="showcase">
      <div class="showcase-track" id="track">
        {[...tools, ...tools].map(tool => {
          const c = catMap[tool.cat];
          return (
            <a class="sc" href={tool.href} style={`--c:${c.color};--cs:${c.soft}`}>
              <span class="sc-icon">{tool.icon}</span>
              <span class="sc-name">{tool.short}</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section-heading">
      <div class="wrap">
        <div class="section-rule" aria-hidden="true"></div>
        <h2>15 个实验，4 个方向</h2>
        <p class="section-sub">Every tool here started as a "what if" — pick a direction and start playing.</p>
      </div>
    </section>

    <section class="categories" id="categories">
      <div class="wrap">
        <div class="bento-row">
          {bentoBlocks.slice(0, 2).map(b => (
            <a class="bento" href={`/tools/#${b.cat}`} style={`--bg:${b.bg};--c:${b.c}`}>
              <div class="bento-deco" set:html={b.deco.replace('\n', '<br/>')} />
              <h3>{b.label}</h3>
              <p>{b.desc}</p>
              <span class="bento-count">{b.count} 个工具 →</span>
            </a>
          ))}
        </div>
        <div class="bento-row">
          {bentoBlocks.slice(2, 4).map(b => (
            <a class="bento" href={`/tools/#${b.cat}`} style={`--bg:${b.bg};--c:${b.c}`}>
              <div class="bento-deco" set:html={b.deco.replace('\n', '<br/>')} />
              <h3>{b.label}</h3>
              <p>{b.desc}</p>
              <span class="bento-count">{b.count} 个工具 →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <footer>
    <div class="wrap footer-inner">
      <span>© 2026 Song Chaoyang</span>
      <a href="https://github.com/Elena176396" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </footer>

</body>
</html>


<style>
  :global(*) { box-sizing: border-box; margin: 0; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    color: #1a1c1e;
    background: #e7e9ed;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
                 "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    position: relative; min-height: 100vh; overflow-x: hidden;
  }

  /* animated cold orbs */
  :global(body)::before {
    content: ''; position: fixed; top: 0; left: 0;
    width: 140%; height: 140%;
    background:
      radial-gradient(circle 550px at 10% 15%, rgba(80,100,180,.18), transparent),
      radial-gradient(circle 450px at 85% 10%, rgba(120,90,170,.14), transparent),
      radial-gradient(circle 600px at 55% 60%, rgba(70,140,160,.12), transparent),
      radial-gradient(circle 400px at 30% 80%, rgba(90,110,170,.1), transparent);
    z-index: 0; pointer-events: none;
    animation: drift 28s ease-in-out infinite alternate;
  }
  @keyframes drift {
    0%   { transform: translate(0, 0) scale(1); }
    33%  { transform: translate(-4%, 2%) scale(1.02); }
    66%  { transform: translate(3%, -3%) scale(.98); }
    100% { transform: translate(-2%, 4%) scale(1.01); }
  }

  :global(body) > * { position: relative; z-index: 1; }
  .wrap { width: min(1100px, calc(100% - 48px)); margin-inline: auto; }

  /* ═══ HEADER ═══ */
  header {
    position: sticky; top: 0; z-index: 10;
    background: rgba(231,233,237,.48);
    backdrop-filter: blur(24px) saturate(1.3);
    -webkit-backdrop-filter: blur(24px) saturate(1.3);
    border-bottom: 1px solid rgba(255,255,255,.4);
    background-image: linear-gradient(135deg, rgba(255,255,255,.15) 0%, transparent 40%);
  }
  .header-inner { height: 64px; display: flex; align-items: center; justify-content: space-between; }
  .brand { color: inherit; text-decoration: none; font-size: 12.5px; font-weight: 780; letter-spacing: .14em; }
  .gh-link {
    display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; color: #8a8d96;
    background: rgba(255,255,255,.25); border: 1px solid rgba(255,255,255,.45);
    border-radius: 50%;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    transition: color .2s, background .2s;
  }
  .gh-link:hover { color: #1a1c1e; background: rgba(255,255,255,.45); }

  /* ═══ HERO ═══ */
  .hero { padding: clamp(72px, 12vw, 150px) 0 clamp(20px, 3vw, 36px); text-align: center; }
  h1 { font-size: clamp(36px, 7vw, 64px); font-weight: 820; line-height: 1.15; letter-spacing: -.04em; color: #0a0a0c; }
  .subtitle { max-width: 460px; margin: 20px auto 0; font-size: clamp(13px, 1.6vw, 15px); line-height: 1.7; color: #8e919a; }

  /* glass CTA */
  .cta {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 32px; padding: 13px 28px;
    font-size: 14px; font-weight: 680; color: #1a1c1e;
    background: rgba(255,255,255,.4);
    background-image: linear-gradient(135deg, rgba(255,255,255,.25) 0%, transparent 50%);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 999px; text-decoration: none;
    box-shadow: 0 2px 10px rgba(50,55,80,.08), inset 0 1px 0 rgba(255,255,255,.5);
    transition: transform .2s, box-shadow .2s, background .2s, color .2s;
  }
  .cta:hover {
    transform: translateY(-2px);
    background: rgba(30,34,50,.82); background-image: none;
    color: #fff; border-color: rgba(255,255,255,.15);
    box-shadow: 0 6px 24px rgba(40,50,80,.2);
  }
  .cta svg { transition: transform .2s; }
  .cta:hover svg { transform: translateX(3px); }

  /* ═══ SHOWCASE ═══ */
  .showcase { overflow: hidden; padding: clamp(20px, 4vw, 44px) 0 clamp(44px, 6vw, 76px); }
  .showcase-track {
    display: flex; gap: 16px; position: relative;
    will-change: transform;
    animation: marquee 50s linear infinite;
  }
  .showcase:hover .showcase-track { animation-play-state: paused; }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* glass card with category-tinted icon */
  .sc {
    position: relative; flex-shrink: 0;
    width: 105px; height: 142px;
    background: rgba(255,255,255,.3);
    background-image: linear-gradient(135deg, rgba(255,255,255,.22) 0%, transparent 50%);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    border: 1px solid rgba(255,255,255,.5); border-radius: 18px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    text-decoration: none; color: inherit; cursor: pointer;
    box-shadow: 0 2px 8px rgba(50,55,80,.04), 0 8px 24px rgba(50,55,80,.06), inset 0 1px 0 rgba(255,255,255,.55);
    will-change: transform;
    transition: box-shadow .3s ease, background .3s ease;
  }
  .sc:hover {
    background: rgba(255,255,255,.48);
    box-shadow: 0 4px 12px rgba(50,55,80,.07), 0 16px 40px rgba(50,55,80,.1), inset 0 1px 0 rgba(255,255,255,.65);
  }
  .sc-icon {
    width: 48px; height: 48px; display: grid; place-items: center; border-radius: 14px;
    background: color-mix(in srgb, var(--c) 8%, rgba(255,255,255,.32));
    border: 1px solid color-mix(in srgb, var(--c) 12%, rgba(255,255,255,.4));
    font-family: Georgia, "Songti SC", serif; font-size: 22px; color: var(--c);
  }
  .sc-name { font-size: 11px; font-weight: 620; color: #6a6d76; text-align: center; line-height: 1.25; padding: 0 6px; }
  .sc::after {
    content: ''; position: absolute; bottom: 10px; left: 25%; right: 25%;
    height: 2.5px; border-radius: 2px; background: var(--c); opacity: .14;
  }

  /* ═══ SECTION HEADING ═══ */
  .section-heading { text-align: center; padding: clamp(24px, 4vw, 48px) 0 clamp(32px, 5vw, 56px); }
  .section-rule {
    width: 40px; height: 2px; margin: 0 auto 24px;
    background: rgba(50,55,80,.15); border-radius: 2px;
  }
  .section-heading h2 {
    font-size: clamp(28px, 5vw, 44px); font-weight: 800;
    letter-spacing: -.04em; line-height: 1.15; color: #0a0a0c;
  }
  .section-sub {
    max-width: 480px; margin: 16px auto 0;
    font-size: clamp(13px, 1.5vw, 14.5px); line-height: 1.7; color: #8e919a;
  }

  /* ═══ BENTO ═══ */
  .categories { padding-bottom: clamp(60px, 8vw, 100px); }
  .bento-row { display: grid; gap: 14px; margin-bottom: 14px; }
  .bento-row:nth-child(1) { grid-template-columns: 3fr 2fr; }
  .bento-row:nth-child(2) { grid-template-columns: 2fr 3fr; }

  .bento {
    position: relative; overflow: hidden;
    min-height: clamp(200px, 22vw, 260px);
    border-radius: 22px; padding: 32px 36px;
    display: flex; flex-direction: column; justify-content: flex-end;
    background: var(--bg);
    background-image: linear-gradient(135deg, rgba(255,255,255,.2) 0%, transparent 45%);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border: 1px solid rgba(255,255,255,.42);
    box-shadow: 0 2px 8px rgba(50,55,80,.03), inset 0 1px 0 rgba(255,255,255,.4);
    text-decoration: none; color: #1a1c1e;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease, filter .3s ease;
  }
  .bento:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,.65);
    box-shadow: 0 10px 36px rgba(50,55,80,.09), inset 0 1px 0 rgba(255,255,255,.55);
    filter: brightness(1.06);
  }
  .bento h3 { font-size: clamp(22px, 2.8vw, 28px); font-weight: 760; letter-spacing: -.03em; margin-bottom: 8px; }
  .bento p { font-size: 14px; color: rgba(26,28,30,.36); line-height: 1.6; max-width: 280px; }
  .bento-count {
    display: inline-flex; align-items: center; gap: 4px;
    margin-top: 14px; font-size: 12.5px; font-weight: 650; color: var(--c); opacity: .55;
  }
  .bento-deco {
    position: absolute; top: 50%; right: 24px; transform: translateY(-50%);
    font-family: Georgia, "Songti SC", "STSong", serif;
    font-size: clamp(72px, 10vw, 100px); line-height: .95; letter-spacing: -.06em;
    color: var(--c); opacity: .06; pointer-events: none; white-space: nowrap;
  }

  /* ═══ FOOTER ═══ */
  footer { border-top: 1px solid rgba(255,255,255,.3); }
  .footer-inner { padding: 28px 0 48px; display: flex; justify-content: space-between; color: #9a9da6; font-size: 13px; }
  .footer-inner a { color: inherit; text-decoration: none; transition: color .15s; }
  .footer-inner a:hover { color: #555860; }

  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 860px) {
    .sc { width: 88px; height: 120px; border-radius: 15px; }
    .sc-icon { width: 40px; height: 40px; font-size: 19px; border-radius: 12px; }
    .sc-name { font-size: 10px; }
    .bento-deco { font-size: 64px; right: 16px; }
  }
  @media (max-width: 560px) {
    .wrap { width: min(100% - 32px, 1100px); }
    .hero { padding: 48px 0 16px; }
    .cta { margin-top: 24px; padding: 11px 24px; font-size: 13px; }
    .sc { width: 76px; height: 104px; border-radius: 14px; gap: 7px; }
    .sc-icon { width: 36px; height: 36px; font-size: 17px; border-radius: 10px; }
    .sc-name { font-size: 9px; }
    .section-heading { padding: 20px 0 28px; }
    .section-rule { margin-bottom: 16px; }
    .bento-row:nth-child(1),
    .bento-row:nth-child(2) { grid-template-columns: 1fr; }
    .bento { min-height: 180px; padding: 24px 28px; border-radius: 18px; }
    .bento h3 { font-size: 22px; }
    .bento-deco { font-size: 56px; right: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    :global(body)::before { animation: none !important; }
    .showcase-track { animation: none !important; }
    *, *::before, *::after { transition-duration: 0s !important; }
  }
</style>


<script>
  const showcase = document.querySelector('.showcase');
  const track = document.getElementById('track');
  const cards = track.querySelectorAll('.sc');

  function curve() {
    const box = showcase.getBoundingClientRect();
    const cx = box.width / 2;
    const mx = new DOMMatrix(getComputedStyle(track).transform);
    const tx = mx.m41;

    cards.forEach(card => {
      const mid = card.offsetLeft + tx + card.offsetWidth / 2;
      const n = Math.max(-1.4, Math.min(1.4, (mid - cx) / (box.width * 0.48)));
      const y   = (1 - n * n) * 26;
      const rot = n * 5;
      const ry  = n * -8;
      const s   = 1 - Math.abs(n) * 0.04;
      card.style.transform =
        'perspective(900px) rotateY(' + ry + 'deg) translateY(' + y + 'px) rotate(' + rot + 'deg) scale(' + s + ')';
    });
    requestAnimationFrame(curve);
  }
  curve();
</script>
